# Git metadata is not part of the image build. Component versions come from
# source manifests or pinned releases; revisions remain traceable through
# submodule gitlinks and packaged release provenance.
.git
**/.git

# Local deployment profiles contain Terraform state, kubeconfigs, IAM seeds,
# and generated JWT tokens.
.akernel/
.local/
**/.terraform/
**/.terraform.lock.hcl
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/terraform.tfvars

# Standalone runtime state.
deploy/standalone/data/
deploy/standalone/logs/
deploy/standalone/output/

# Local source build outputs.
# distill-fs is consumed as a release artifact, not from this checkout.
src/distill-fs/
src/sandboxd/output/
src/yuanrong/

# Python caches and package outputs.
**/__pycache__/
**/.pytest_cache/
**/*.py[cod]
**/*.egg-info/

# Local image and archive outputs.
builder/*.img
builder/*.tar
builder/*.tar.gz

# Editor and operating-system metadata.
.DS_Store
.idea/
.vscode/
