          "uid": "prometheus"
        },
        "query": "label_values(adx_coordinator_node_capacity_cpu_millis, cluster)",
        "refresh": 2,
        "multi": false,
        "includeAll": true,
        "allValue": "..*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "allValue": "..*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(adx_coordinator_node_capacity_cpu_millis{cluster=~\"$cluster\"}, adx_env)",
        "includeAll": true,
        "label": "adx_env",
        "name": "adx_env",
        "options": [],
        "query": {
          "query": "label_values(adx_coordinator_node_capacity_cpu_millis{cluster=~\"$cluster\"}, adx_env)",
          "refId": "Prometheus-adx-env-Variable"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "name": "runtime_id",
        "label": "Runtime ID regex",
        "description": "RE2 regex. Use \\x60 to match a backtick.",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 0
      },
      {
        "name": "log_search",
        "label": "Log text contains",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0,
        "description": "Case-sensitive literal text. Enter backslashes and quotes directly; leave empty to match all lines."
      }
    ]
  },
  "time": {
    "from": "now-15m",
    "to": "now"
  },
