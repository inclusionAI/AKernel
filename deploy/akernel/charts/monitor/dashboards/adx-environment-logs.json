  ],
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "id": 21,
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{cluster=~\"$cluster\",adx_env=~\"$adx_env\",component_name=\"adx-runtime\"} | runtime_id =~ `${runtime_id:raw}` | label_format adx_keyword_match=`{{ contains (urldecode \"${log_search:percentencode}\") (__line__) }}` | adx_keyword_match=\"true\" | drop adx_keyword_match",
          "refId": "A",
          "maxLines": 200
        }
      ],
      "title": "Environment Logs",
      "type": "logs",
      "description": "Main-process stdout/stderr. Runtime ID contains Environment ID and generation. Runtime filter is a regex; .* matches all, .*environment-id.* selects its generations. Log text is literal and case-sensitive. At most 200 lines per query. SDK command responses are separate."
    },
    {
      "id": 23,
      "type": "table",
      "title": "Environment Create Completion Traces",
      "description": "One environment.create business span per sampled create call, ending at its final result after scheduling and runtime startup. Duration excludes the earlier HTTP authentication/spec preparation. Success includes successful reuse; use the successful-new-create metric to exclude replay/reuse. Unknown means an uncertain result, not confirmed failure. Sampling means this table is not a complete request ledger.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Trace ID"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": false
              },
              {
                "id": "custom.width",
                "value": 290
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "View Trace",
                    "url": "",
                    "internal": {
                      "datasourceUid": "tempo",
                      "datasourceName": "Tempo",
                      "query": {
                        "query": "${__value.raw}",
                        "queryType": "traceql"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Start Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 225
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Component"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Create Completion Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 155
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Outcome"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "tableType": "spans",
          "query": "{ (resource.cluster = \"${cluster:raw}\" || \"${cluster:raw}\" = \"..*\") && resource.adx_env =~ \"$adx_env\" && resource.service.name = \"adx-apiserver\" && name = \"environment.create\" } | select(span.environment.id, span.environment.create.outcome, resource.service.name)",
          "limit": 20,
          "spss": 20,
          "filters": []
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "traceService": true,
              "traceName": true,
              "spanID": true,
              "nested": true,
              "adx_env": true,
              "cluster": true
            },
            "indexByName": {
              "duration": 0,
              "Duration": 0,
              "environment.create.outcome": 1,
              "environment.id": 2,
              "name": 3,
              "Name": 3,
              "time": 4,
              "Start time": 4,
              "service.name": 5,
              "traceIdHidden": 6
            },
            "renameByName": {
              "time": "Start Time",
              "name": "Operation",
              "environment.id": "Environment ID",
              "environment.create.outcome": "Outcome",
              "service.name": "Component",
              "duration": "Create Completion Time",
              "traceIdHidden": "Trace ID",
              "Start time": "Start Time",
              "Name": "Operation",
              "Duration": "Create Completion Time"
            }
          }
        }
      ]
    }
  ],
  "preload": false,
  "refresh": "",
  "schemaVersion": 42,
  "tags": [
