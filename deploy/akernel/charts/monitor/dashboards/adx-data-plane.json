{
  "annotations": {
    "list": []
  },
  "description": "ADX Ingress HTTP requests include control-plane routes. Latency ends when the response is returned, not when a streaming body finishes. All queries are isolated by adx_env.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Ingress Requests (selected range)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(data_plane_ingress_http_requests_total{cluster=~\"$cluster\",adx_env=~\"$adx_env\"}[$__range]))",
          "legendFormat": "requests",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "description": "HTTP requests observed by the shared Ingress during the selected range, including API and workload traffic. increase() estimates sampled counter deltas; fractional counts are possible.",
      "maxDataPoints": 1
    },
    {
      "id": 2,
      "type": "table",
      "title": "Ingress Responses by Class (selected range)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Responses",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by(cluster,adx_env,class)(increase(data_plane_ingress_http_responses_total{cluster=~\"$cluster\",adx_env=~\"$adx_env\"}[$__range]))",
          "legendFormat": "{{class}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "description": "Estimated response counts in the selected range, grouped by cluster/environment and HTTP status class. 1xx includes successful 101 WebSocket upgrades. SSE HTTP 200 does not imply final Environment creation success. Older producers counted 101 as other; upgrades do not rewrite historical samples.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "cluster": "Cluster",
              "adx_env": "ADX Env",
              "class": "HTTP class",
              "Value": "Responses"
            }
          }
        }
      ],
      "maxDataPoints": 1
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Ingress 4xx / 5xx Ratio (selected range)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(data_plane_ingress_http_responses_total{cluster=~\"$cluster\",adx_env=~\"$adx_env\",class=\"4xx\"}[$__range])) / (sum(increase(data_plane_ingress_http_responses_total{cluster=~\"$cluster\",adx_env=~\"$adx_env\"}[$__range])) > 0)",
          "legendFormat": "4xx",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(data_plane_ingress_http_responses_total{cluster=~\"$cluster\",adx_env=~\"$adx_env\",class=\"5xx\"}[$__range])) / (sum(increase(data_plane_ingress_http_responses_total{cluster=~\"$cluster\",adx_env=~\"$adx_env\"}[$__range])) > 0)",
          "legendFormat": "5xx",
          "refId": "B",
          "instant": true,
          "range": false
        }
      ],
      "description": "Selected-range 4xx or 5xx response count divided by all observed HTTP responses. No responses means no defined ratio. 101 is successful upgrade; SSE final business failures require lifecycle metrics.",
      "maxDataPoints": 1
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Ingress Response Header Latency P50 / P95 / P99",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(data_plane_ingress_http_request_duration_seconds_bucket{cluster=~\"$cluster\",adx_env=~\"$adx_env\"}[$__rate_interval])))",
          "legendFormat": "P50",
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(data_plane_ingress_http_request_duration_seconds_bucket{cluster=~\"$cluster\",adx_env=~\"$adx_env\"}[$__rate_interval])))",
          "legendFormat": "P95",
          "refId": "B",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(data_plane_ingress_http_request_duration_seconds_bucket{cluster=~\"$cluster\",adx_env=~\"$adx_env\"}[$__rate_interval])))",
          "legendFormat": "P99",
          "refId": "C",
          "instant": false,
          "range": true
        }
      ],
      "description": "Time until Ingress obtains response headers. For SSE this can be much shorter than business completion or stream lifetime. Idle windows with no observations have no meaningful percentile.",
      "maxDataPoints": 200,
      "interval": "1m"
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Ingress Requests In Flight",
      "datasource": {
        "type": "prometheus",
