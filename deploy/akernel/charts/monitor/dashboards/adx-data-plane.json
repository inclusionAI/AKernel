        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(data_plane_ingress_http_requests_total{adx_env=~\"$adx_env\"}[5m]))",
          "legendFormat": "requests",
          "refId": "A"
