      "title": "Per-node snapshot",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "host_name",
                "Value #A",
                "Value #B",
                "Value #C",
                "Value #D",
                "Value #E",
                "Value #F",
                "Value #G",
                "Value #H"
              ]
            }
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "host_name",
            "mode": "outer"
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "CPU usage %",
            "mode": "binary",
            "binary": {
              "left": "Value #A",
              "operator": "/",
              "right": "Value #B"
            },
            "replaceFields": false
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Memory usage %",
            "mode": "binary",
            "binary": {
              "left": "Value #C",
              "operator": "/",
              "right": "Value #D"
            },
            "replaceFields": false
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "/ usage %",
            "mode": "binary",
            "binary": {
              "left": "Value #E",
              "operator": "/",
              "right": "Value #F"
            },
            "replaceFields": false
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "/home/akernel usage %",
            "mode": "binary",
            "binary": {
              "left": "Value #G",
              "operator": "/",
              "right": "Value #H"
            },
            "replaceFields": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Value #A": true,
              "Value #C": true,
              "Value #E": true,
              "Value #G": true
            },
            "indexByName": {
              "host_name": 0,
              "CPU usage %": 1,
              "Value #B": 2,
              "Memory usage %": 3,
              "Value #D": 4,
              "/ usage %": 5,
              "Value #F": 6,
              "/home/akernel usage %": 7,
              "Value #H": 8
            },
            "renameByName": {
              "Value #B": "CPU limit (cores)",
              "Value #D": "Memory total",
              "Value #F": "/ capacity",
              "Value #H": "/home/akernel capacity"
            }
          }
        }
      ],
