# Bash compatibility exports; host-profile.json is the only maintained pin.
_pvm_host_exports=$(python3 - "$(dirname "${BASH_SOURCE[0]}")/host-profile.json" <<'PVM_HOST_PROFILE'
import json,shlex,sys
from pathlib import Path
p=json.loads(Path(sys.argv[1]).read_text())
assert p['schema']==1
s,t=p['source'],p['target']
values={'PVM_HOST_SOURCE_REPOSITORY':s['repository'],'PVM_HOST_SOURCE_COMMIT':s['commit'],
        'PVM_HOST_BASELINE_COMMIT':s['baseline_commit'],'PVM_HOST_TARGET_PROFILE':t['profile'],
        'PVM_HOST_UPSTREAM_REPOSITORY':s['upstream_repository'],'PVM_HOST_UPSTREAM_BRANCH':s['upstream_branch'],
        'PVM_HOST_UPSTREAM_COMMIT':s['upstream_commit'],'PVM_HOST_QUALIFIED_KERNEL':t['kernel_release']}
for key,value in values.items():print(key+'='+shlex.quote(value))
PVM_HOST_PROFILE
) || return 1
eval "${_pvm_host_exports}"
unset _pvm_host_exports
