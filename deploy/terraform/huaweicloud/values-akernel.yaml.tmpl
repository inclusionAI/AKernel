kruise:
  enabled: ${enable_kruise}

auth:
  litebusDataKey: "${iam_litebus_data_key}"

monitoring:
  akernelEnv: "${akernel_env}"
%{ if install_monitor ~}
  prometheusEndpoint: "http://prometheus.${monitor_namespace}.svc:9090"
  lokiEndpoint: "http://loki.${monitor_namespace}.svc:3100"
  tempoEndpoint: "http://tempo.${monitor_namespace}.svc:3200"
%{ endif ~}

etcd:
  image:
    repository: "${etcd_image_repository}"
    tag: "${etcd_image_tag}"
  persistence:
    enabled: true
    storageClassName: "csi-disk"
    size: "${etcd_pvc_size}"
    accessModes:
      - "ReadWriteOnce"
  resources:
    limits:
      cpu: "${etcd_cpu}"
      memory: "${etcd_memory}"
      ephemeral-storage: "${etcd_ephemeral}"
    requests:
      cpu: "${etcd_cpu}"
      memory: "${etcd_memory}"
      ephemeral-storage: "${etcd_ephemeral}"

master:
  replicas: ${master_replicas}
  image:
    repository: "${master_image_repository}"
    tag: "${master_image_tag}"
  service:
    type: "${master_service_type}"
    annotations: ${jsonencode(master_service_annotations)}
    loadBalancerIP: "${master_service_loadbalancer_ip}"
  resources:
    limits:
      cpu: "${master_cpu}"
      memory: "${master_memory}"
      ephemeral-storage: "${master_ephemeral}"
    requests:
      cpu: "${master_cpu}"
      memory: "${master_memory}"
      ephemeral-storage: "${master_ephemeral}"
%{ if frontend_enabled ~}

frontend:
  enabled: true
  replicas: ${frontend_replicas}
  image:
    repository: "${master_image_repository}"
    tag: "${master_image_tag}"
  resources:
    limits:
      cpu: "${frontend_cpu}"
      memory: "${frontend_memory}"
    requests:
      cpu: "${frontend_cpu}"
      memory: "${frontend_memory}"
%{ endif ~}

node:
  image:
    repository: "${node_image_repository}"
    tag: "${node_image_tag}"
  resources:
    limits:
      ephemeral-storage: "${node_ephemeral}"
    requests:
      ephemeral-storage: "${node_ephemeral}"
  homeDisk:
    useEphemeralPVC: ${node_home_use_csi_ephemeral}
    storageClassName: "${node_home_csi_storage_class}"
    size: "${node_home_csi_size}"
    accessModes:
      - "ReadWriteOnce"
  secret:
    create: ${node_secret_create}
    oss_auths: ${jsonencode(oss_auths)}
    registry_auths: ${jsonencode(registry_auths)}
  config:
    oss:
      type: "oss"
      oss:
        scheme: "http"
        endpoint: "${oss_endpoint}"
        access_key_id: "${oss_access_key_id}"
        access_key_secret: "${oss_access_key_secret}"
        bucket: "${oss_bucket}"
        object_prefix: "${oss_object_prefix}"
        retry_limit: 3
        connect_timeout: 300
        timeout: 300
        proxy:
          url: "${oss_proxy_url}"
          ping_url: ""
          fallback: true
          check_interval: 60
    registry:
      type: "registry"
      registry:
        scheme: "https"
        host: ""
        repo: ""
        auth: ""
        skip_verify: true
        timeout: 300
        connect_timeout: 300
        blob_url_scheme: "http"
        proxy:
          url: "${oss_proxy_url}"
          ping_url: ""
          fallback: true
          check_interval: 60
    resourceControl:
      memoryLimit: "2G"
      cpuQuota: "100%"
    sandboxd:
      config: |-
        rootDir="/home/akernel/sandboxd/root"
        storeDir="/home/akernel/sandboxd/store"

        [plugin]
        disable_tcp_service=false
        stream_idle_timeout=""
        stream_server_address=""
        stream_server_port=""

        [plugin.network]
        ip_range="172.17.0.1/16"
        nat_backend="${sandboxd_nat_backend}"
        enable_network_acl=true

        [plugin.resource]
        cgroup_cache_size=800
        pids_max=4096
        netns_cache_size=1000
        interface_cache_size=1000
        cgroup_root_name="/akernel"
        max_instance_num=1000
        enable_cache_in_stock_mode=true

        [plugin.runtime]
        image_lib_dir="/home/akernel/images"
        filestore_dir="/home/akernel/xfs"
        filestore_dir_size="200G"
        overlay_tmpfs_size="10G"

        [plugin.runtime.basic_spec]
        runsc="/home/akernel/images/config.json"

        [plugin.runtime.runtime_binary]
        runsc="/usr/local/bin/runsc"
        kata="/usr/local/bin/containerd-shim-kata-v2"

        [plugin.runtime.kata]
        config_path="/opt/kata/share/defaults/kata-containers/runtime-rs/configuration-dragonball.toml"
        kvm_device="/dev/kvm"
        dan_config_dir="/run/kata-containers/dans"
        logger_binary="/usr/local/bin/sandbox-logger"

        # image-manager config. root holds image-manager runtime state
        # (daemons/, mount_records.db) and is wiped on pod change; input
        # configs live under /home/akernel/sandboxd/config/ so the wipe never
        # hits the read-only bind-mounted config files.
        [plugin.image]
        root="/home/akernel/sandboxd/image_manager"
        distill_fs_bin="/usr/local/bin/distill_fs"
        oss_template="/home/akernel/sandboxd/config/oss.json"
        nydus_template="/home/akernel/sandboxd/config/registry.json"
        nydus_suffix="_nydus_v3"
        oss_auths_path="/home/akernel/sandboxd/config/oss_auths.json"
        registry_auths_path="/home/akernel/sandboxd/config/registry_auths.json"
        cgroup_memory_limit="64GiB"

        # node-resource config. sock_path matches what yuanrong's C++
        # external_system_collector reads, so it must stay /var/run/...
        [plugin.node_resource]
        provider="kubernetes"
        sock_path="/var/run/resource.sock"

traefik:
  enabled: ${install_traefik}
  replicas: ${traefik_replicas}
  enableWebEntrypoint: ${traefik_enable_web_entrypoint}
  image:
    repository: "${traefik_image_repository}"
    tag: "${traefik_image_tag}"
  ports:
%{ if traefik_enable_web_entrypoint ~}
    web: ${traefik_web_port}
    websecure: ${traefik_websecure_port}
%{ else ~}
    tcp: ${traefik_tcp_port}
%{ endif ~}
  service:
    type: "${traefik_service_type}"
    annotations: ${jsonencode(traefik_service_annotations)}
    loadBalancerIP: "${traefik_service_loadbalancer_ip}"
  tls:
    enabled: ${traefik_tls_enabled}
    createSecret: ${traefik_tls_create_secret}
%{ if traefik_tls_cert != "" ~}
    moduleCrt: ${jsonencode(traefik_tls_cert)}
%{ endif ~}
%{ if traefik_tls_key != "" ~}
    moduleKey: ${jsonencode(traefik_tls_key)}
%{ endif ~}
  internalStats:
    enabled: ${traefik_internal_stats}
    image: "${traefik_internal_stats_image}"
  grafana:
    enabled: ${traefik_grafana_enabled}
%{ if traefik_grafana_url != "" ~}
    url: "${traefik_grafana_url}"
%{ endif ~}
